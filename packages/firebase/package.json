{
  "name": "@mikejhill/portable-document-firebase",
  "version": "0.1.0",
  "description": "Firebase Auth and Firestore adapters, publications, invitations, membership, presence, rules, and indexes.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikejhill/portable-document-kit.git",
    "directory": "packages/firebase"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./firestore.rules": "./rules/firestore.rules",
    "./firestore.indexes.json": "./rules/firestore.indexes.json"
  },
  "files": [
    "dist",
    "rules"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap"
  },
  "dependencies": {
    "@mikejhill/portable-document-core": "^0.1.0",
    "firebase": "^12.0.0"
  }
}
