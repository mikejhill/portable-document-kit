{
  "name": "@mikejhill/portable-document-browser",
  "version": "0.1.0",
  "description": "SSR-safe fragment routing, browser history, lifecycle, and portable URL creation.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikejhill/portable-document-kit.git",
    "directory": "packages/browser"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap"
  },
  "dependencies": {
    "@mikejhill/portable-document-codec": "^0.1.0"
  }
}
